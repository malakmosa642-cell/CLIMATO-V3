# ==============================================================================
# CLIMATO — Environment Configuration Template
# Copy to .env for local development or inject via platform secret manager.
# NEVER commit real tokens or secrets to version control.
# ==============================================================================

# Runtime Environment ("development" | "production" | "test")
NODE_ENV="development"

# APP_URL: Public URL where CLIMATO is hosted (injected in cloud environments)
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Server-side Gemini API key (if AI capabilities are enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# Security & Authentication Secrets (REQUIRED IN PRODUCTION)
# ==============================================================================

# Admin secret protecting /api/v1/keys, /api/audit-logs, and /api/demo-requests.
# Passed via X-Climato-Admin-Secret header. Fails closed in production if unset.
CLIMATO_ADMIN_SECRET=""

# HMAC-SHA256 signing secret for geofence alert webhook payloads.
# Fails closed in production if unset; uses ephemeral CSPRNG secret in dev.
CLIMATO_WEBHOOK_SECRET=""

# Set to "true" to disable seeding the default sandbox evaluation API key
# (automatically disabled whenever NODE_ENV="production").
CLIMATO_DISABLE_DEMO_KEY="false"

# Optional override for SQLite database path (defaults to ./data/terrapulse.db).
# Automated tests use isolated temporary files or ":memory:".
CLIMATO_DB_PATH=""

# ==============================================================================
# Satellite & Meteorological Data Provider Credentials (Server-Side Only)
# ==============================================================================

# NASA Earthdata Bearer Token (GES DISC OPeNDAP, AppEEARS, PO.DAAC Harmony)
# Leave empty to keep unauthenticated CMR discovery + Giovanni CSV import mode.
NASA_EARTHDATA_TOKEN=""

# NOAA Climate Data Online (CDO v2) API Token for surface weather station validation
NOAA_CDO_TOKEN=""

# ESA Copernicus Data Space Ecosystem OData/STAC Token (Sentinel-6, TROPOMI)
COPERNICUS_DATA_SPACE_TOKEN=""

# USGS EROS M2M Token (Landsat 8/9 OLI/TIRS collection workflows)
USGS_EROS_M2M_TOKEN=""
